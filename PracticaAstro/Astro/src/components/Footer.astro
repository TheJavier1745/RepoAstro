---
import IndicadoresEconomicos from './IndicadoresEconomicos.jsx';
const today = new Date();
---

<footer>
  <div class="footer-content">
    <div class="footer-box">
      <div class="footer-left">
        &copy; {today.getFullYear()} Consultora AP Ltda. Todos los derechos reservados.
      </div>
    </div>
    <div class="footer-box">
      <div class="footer-right">
        <IndicadoresEconomicos client:only="react" />
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 2em 1em 2em 1em;
    background: linear-gradient(var(--gray-gradient)) no-repeat;
    color: rgb(var(--gray));
    text-align: center;
  }
  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
  }
  .footer-box {
    flex: 1;
    display: flex;
    justify-content: center;
  }
  .footer-left {
    text-align: left;
  }
  .footer-right {
    text-align: right;
  }
  .social-links {
    display: flex;
    justify-content: center; /* Cambiar a center para centrar los logos */
    gap: 1em;
    margin-top: 1em;
  }
  .social-links a {
    text-decoration: none;
    color: rgb(var(--gray));
  }
  .social-links a:hover {
    color: rgb(var(--gray-dark));
  }
</style>
