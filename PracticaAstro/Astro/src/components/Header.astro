---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
    <nav>
        <!-- ✅ Logo a la izquierda -->
        <h2 class="logo">
            <a href="/">
                <img src="/utilitarios/logo_Cuadrado-min.jpg" alt={SITE_TITLE} width="50" height="50" />
            </a>
        </h2>

        <!-- ✅ Menú en computadoras -->
        <div class="nav-center">
            <HeaderLink href="/">Inicio</HeaderLink>
            <HeaderLink href="/blog">Testimonios</HeaderLink>
            <HeaderLink href="/about">Acerca de nosotros</HeaderLink>
            <HeaderLink href="/contact">Contáctanos</HeaderLink>
        </div>

        <!-- ✅ Contenedor derecho con sesión y menú en móviles -->
        <div class="nav-right">
            <!-- ✅ Ícono de iniciar sesión -->
            <a href="/login" class="login-icon">
                <svg viewBox="0 0 16 16" aria-hidden="true" width="30" height="30" fill="#666666">
                    <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm0 14.5a6.5 6.5 0 1 1 0-13 6.5 6.5 0 0 1 0 13z"></path>
                    <path d="M8 4a1.5 1.5 0 1 0 0 3A1.5 1.5 0 0 0 8 4zM8 7.5A3.5 3.5 0 0 0 4.5 11h7A3.5 3.5 0 0 0 8 7.5z"></path>
                </svg>
            </a>

            <!-- ✅ Botón de menú en móviles -->
            <button class="menu-toggle" aria-label="Abrir menú">
                ☰
            </button>
        </div>
    </nav>

    <!-- ✅ Menú desplegable en móviles -->
    <div class="mobile-menu">
        <HeaderLink href="/">Inicio</HeaderLink>
        <HeaderLink href="/blog">Testimonios</HeaderLink>
        <HeaderLink href="/about">Acerca de nosotros</HeaderLink>
        <HeaderLink href="/contact">Contáctanos</HeaderLink>
    </div>
</header>

<style>
    /* ✅ Header fijo */
    header {
        width: 100%;
        position: fixed;
        top: 0;
        z-index: 1000;
        background: white;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        padding: 10px 20px;
    }

    /* ✅ Diseño del nav */
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* ✅ Logo a la izquierda */
    .logo {
        margin: 0;
    }

    /* ✅ Menú en computadoras */
    .nav-center {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-grow: 1;
    }

    .nav-center a {
        text-decoration: none;
        color: rgba(8, 10, 11, 0.66);
        font-weight: bold;
        padding: 10px;
        border-bottom: 2px solid transparent;
        transition: color 0.3s ease, border-bottom 0.3s ease;
    }

    .nav-center a:hover {
        color: #1274D9;
        border-bottom: 3px solid #1274D9;
    }

    /* ✅ Contenedor derecho con sesión y menú */
    .nav-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        min-width: 150px;
    }

    /* ✅ Ícono de sesión */
    .login-icon {
        display: block;
        margin-right: 25px;
    }

    /* ✅ Botón del menú en móviles */
    .menu-toggle {
        display: none;
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: #666666;
        font-weight: bold;
        padding: 8px 12px;
        border-radius: 5px;
        transition: background 0.3s ease;
    }

    .menu-toggle:hover {
        background: rgba(102, 102, 102, 0.2);
    }

    /* ✅ Menú desplegable en móviles */
    .mobile-menu {
        position: fixed;
        top: 60px;
        right: 10px;
        width: 300px;
        background: white;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        padding: 10px 0;
        text-align: left;
        border-radius: 5px;
        display: none;
    }

    .mobile-menu a {
        display: block;
        padding: 10px 15px;
        color: black;
        font-weight: bold;
        text-align: left;
        border-bottom: 2px solid transparent;
        transition: color 0.3s ease, border-bottom 0.3s ease;
    }

    .mobile-menu a:hover {
        color: #1274D9;
        border-bottom: 3px solid #1274D9;
    }

    /* ✅ Ajustes para móviles */
    @media (max-width: 720px) {
        /* ✅ Ocultar el menú de escritorio */
        .nav-center {
            display: none;
        }

        /* ✅ Mostrar el botón del menú */
        .menu-toggle {
            display: block;
            margin-right: 40px;
        }

        /* ✅ Ajustar la posición del login en móviles */
        .nav-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .login-icon {
            margin-right: 10px;
        }
    }

    /* ✅ Mostrar menú cuando está activo */
    .mobile-menu.active {
        display: block;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const menuButton = document.querySelector(".menu-toggle");
        const mobileMenu = document.querySelector(".mobile-menu");

        menuButton.addEventListener("click", function () {
            mobileMenu.classList.toggle("active");
        });

        // ✅ Cierra el menú si se hace clic fuera de él
        document.addEventListener("click", function (event) {
            if (!menuButton.contains(event.target) && !mobileMenu.contains(event.target)) {
                mobileMenu.classList.remove("active");
            }
        });
    });
</script>
