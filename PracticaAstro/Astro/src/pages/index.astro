---
import Layout from '../layouts/BlogPost.astro';
---

<Layout
  title="Consultora AP Ltda"
  description="Soluciones integrales para potenciar tu negocio"
  heroImage=""
  pubDate={new Date()}
  updatedDate={new Date()}
>
  <section class="hero">
    <div class="hero-content">
      <img src="/src/utilitarios/logo_Cuadrado-min.jpg" alt="Logo de Consultora AP Ltda" class="hero-logo">
      <h1 class="hero-title">Bienvenido a Consultora AP Ltda</h1>
      <p class="hero-subtitle">
        Soluciones integrales para potenciar tu negocio.
      </p>
      <a href="#servicios" class="btn-primary">Conoce nuestros servicios</a>
    </div>
  </section>
  <br><br><br><br>
  <section id="servicios" class="services">
    <h2 class="section-title">Nuestros Servicios</h2>
    <br>
    <div class="services-grid">
      <div class="service-card">
        <h3>Consultoría Empresarial</h3>
        <p>Optimiza tus procesos y maximiza tus resultados con nuestra asesoría experta.</p>
      </div>
      <div class="service-card">
        <h3>Gestión Financiera</h3>
        <p>Planeación estratégica para un crecimiento sostenible.</p>
      </div>
      <div class="service-card">
        <h3>Capacitación</h3>
        <p>Programas diseñados para el desarrollo de tu equipo.</p>
      </div>
    </div>
  </section>
  <br><br><br>
  <section class="about">
    <h2 class="section-title">Quiénes Somos</h2>
    <p>
      En Consultora AP Ltda, contamos con un equipo de expertos dedicados a brindar soluciones personalizadas que se adapten a las necesidades de nuestros clientes.
    </p>
  </section>

  <style>
    /* Estilos para el logo */
    .hero-logo {
      max-width: 100px;
      height: auto;
      display: block;
      margin: 0 auto 20px auto;
      border-radius: 10px;
    }

    /* Contenido del héroe */
    .hero-content {
      text-align: center;
    }

    /* Botón principal */
    .btn-primary {
      padding: 10px 20px;
      background-color: #007BFF;
      color: white;
      text-decoration: none;
      border-radius: 5px;
      display: inline-block;
      margin-top: 40px;
      margin-bottom: 60px;
      transition: all 0.3s ease;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .btn-primary:hover {
      background-color: #0056b3;
      transform: scale(1.05);
      box-shadow: 0 6px 8px rgba(0, 0, 0, 0.2);
    }

    /* Efecto de animación para el botón */
    @keyframes glow {
      0% {
        box-shadow: 0 0 5px #0056b3;
      }
      50% {
        box-shadow: 0 0 20px #007BFF;
      }
      100% {
        box-shadow: 0 0 5px #0056b3;
      }
    }

    /* Grid de servicios */
    .services-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-around;
      gap: 20px;
      margin-top: 40px;
    }

    /* Tarjetas de servicios */
    .service-card {
      flex: 1 1 calc(33.333% - 20px);
      max-width: calc(33.333% - 20px);
      background: #f9f9f9;
      padding: 20px;
      border: 1px solid #ddd;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      text-align: center;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .service-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 8px 12px rgba(0, 0, 0, 0.2);
    }

    /* Estilos generales */
    .section-title {
      text-align: center;
      color: #333;
    }

    .about p {
      text-align: center;
      margin: 20px auto;
      max-width: 800px;
    }
  </style>
</Layout>
