---
import Layout from '../layouts/BlogPost.astro';
import IndicadoresEconomicos from '../components/IndicadoresEconomicos.jsx';
import BotonesComplejos from '../components/botonescomplejos.jsx';
import DogAPI from '../components/dogApi.jsx';
import JokeAPI from '../components/jokeApi.jsx';
---

<Layout
  description="Soluciones integrales para potenciar tu negocio"
  heroImage=""
  pubDate={new Date()}
>
<section class="hero">
  <div class="hero-content">
    <img src="/src/utilitarios/logo_Cuadrado-min.jpg" alt="Logo de Consultora AP Ltda" class="hero-logo">
    <h1 class="hero-title">Bienvenido a Consultora AP Ltda</h1>
    <p class="hero-subtitle">
      Soluciones integrales para potenciar tu negocio.
    </p>
    <a href="#servicios" class="btn-primary">Conoce nuestros servicios</a>
  </div>
</section>
<section class="image-section"></section>

<section class="about">
  <h2 class="section-title white-title">Quiénes Somos</h2>
  <p>
    En Consultora AP Ltda, contamos con un equipo de expertos dedicados a brindar soluciones personalizadas que se adapten a las necesidades de nuestros clientes.
  </p>
  <a href="/contact" class="btn-primary">Contáctanos</a>
</section>

<section id="servicios" class="admin-container">
  <br><br>
  <h2 class="section-title black-title">Nuestros servicios</h2>
  <BotonesComplejos client:only="react" />

</section>
<DogAPI client:only="react" />

<!-- Sección de chistes -->
<section id="chistes" class="chistes-container">
  <JokeAPI client:only="react" />
</section>

<style>
/* Evitar el scroll horizontal */
body {
  overflow-x: hidden;
  margin: 0;
  padding: 0;
}

.hero {
  position: relative;
  height: 120vh;
  width: 100vw; /* Cambiado de 150vw a 100vw */
  margin-top: -145px;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
              url('/src/utilitarios/1500x844_consultoria_ahorro.png') no-repeat center center;
  background-size: cover;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
}

.about {
  position: relative;
  padding: 80px 20px;
  height: 35vh;
  width: 100vw; /* Cambiado de 300% a 100vw */
  margin-top: -90px;
  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
              url('/src/utilitarios/nosotros1.jpg') no-repeat center center;
  background-size: cover;
  color: white;
  text-align: center;
  left: 50%;
  transform: translateX(-50%);
}

.about p {
  font-size: 1.3rem;
  margin-bottom: 30px;
  text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.7);
}

.hero-logo {
  max-width: 100px;
  height: auto;
  display: block;
  margin: 0 auto 20px auto;
  border-radius: 10px;
}

.hero-content {
  color: white;
  padding: 20px;
  text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.7);
}

.hero-title {
  font-size: 3.5rem;
  font-weight: bold;
  margin-bottom: 50px;
  line-height: 1;
  color: white;
}

.hero-subtitle {
  font-size: 1.5rem;
  margin-bottom: 50px;
  color: white;
}

.btn-primary {
  padding: 15px 30px;
  background-color: rgb(51, 157, 222);
  color: white;
  text-decoration: none;
  border-radius: 50px;
  font-size: 1.2rem;
  font-weight: bold;
  transition: background-color 0.3s ease, transform 0.3s ease;
}

.btn-primary:hover {
  background-color: rgb(58, 141, 243);
  transform: scale(1.05);
}

.image-section {
  text-align: center;
  margin: 40px 0;
}

.featured-image {
  max-width: 100%;
  height: auto;
  border-radius: 10px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.section-title {
  text-align: center;
  font-size: 3rem;
  margin-bottom: 50px;
  font-weight: bold;
  text-shadow: 2px 2px 5px rgba(35, 57, 181, 0.19);
  position: relative;
}

.section-title::after {
  content: '';
  display: block;
  width: 450px;
  height: 4px;
  background: rgb(146, 187, 249);
  margin: 20px auto 0 auto;
  border-radius: 2px;
  opacity: 0.8;
}

/* Estilo específico para el texto blanco del título "Quiénes Somos" */
.white-title {
  color: white;
}

/* Estilo específico para el texto negro del título "Nuestros servicios" */
.black-title {
  color: black;
}

.about {
  text-align: center;
}

.indicadores-container {
  padding: 20px;
  background-color: #f9f9f9;
  border-radius: 8px;
  margin-top: 40px;
}
</style>
</Layout>
