---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];


const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---


<html lang="es">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			body {
				font-family: Arial, sans-serif;
				background-color: #f8f9fa;
				color: #343a40;
				margin: 0;
				padding: 0;
			}

			main {
				display: flex;
				width: calc(100% - 4em);
				max-width: 1400px;
				margin: 2em auto;
				padding: 2em;
				background-color: #ffffff;
				border-radius: 10px;
				box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.1);
			}

			.content {
				flex: 3;
				padding-right: 2em;
			}

			.sidebar {
				flex: 1;
				background-color: #f1f1f1;
				padding: 1em;
				border-radius: 10px;
				box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.1);
				position: sticky;
				top: 20px; /* Adjust the top value as needed */
				height: fit-content; /* Ensure the sidebar height adjusts to its content */
			}

			.hero-image {
				width: 100%;
				margin-bottom: 1.5em;
			}

			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				max-width: 100%;
			}

			.prose {
				max-width: 800px;
				margin: auto;
				padding: 1.5em;
				color: rgb(var(--gray-dark));
				font-size: 1.125rem;
				line-height: 1.8;
			}

			@media (min-width: 768px) {
				.prose {
					font-size: 1.25rem;
				}
			}

			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1.2;
			}

			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 2rem;
				font-weight: bold;
			}

			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}

			.last-updated-on {
				font-style: italic;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="content">
				<div class="title">
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on">
									Última actualización: <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<h1>{title}</h1>
					<hr />
				</div>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="Imagen destacada" />}
				</div>
				<div class="prose">
					<slot />
				</div>
			</div>
			<aside class="sidebar">
				<div style="display: flex; align-items: center; justify-content: space-between;">
					<h2>Ir a...</h2>
					<img src="/src/utilitarios/logo_Cuadrado-min.jpg" alt="logo pequeño para acompañar" style="width: 50px; height: auto; margin-left: 1em;" />
				</div>
				<ul>
					<li><a href="/"><span class="material-icons">home</span> Inicio</a></li>
					<li><a href="/blog"><span class="material-icons">chat</span> Testimonios</a></li>
					<li><a href="/about"><span class="material-icons">info</span> Acerca de nosotros</a></li>
					<li><a href="/contact"><span class="material-icons">contact_mail</span> Contáctanos</a></li>
				</ul>
			</aside>
		</main>
		<Footer />
	</body>
</html>
