---
import Layout from '../layouts/BlogPost.astro';
import IndicadoresEconomicos from '../components/IndicadoresEconomicos.jsx';
import BotonesComplejos from '../components/botonescomplejos.jsx';
import DogAPI from '../components/dogApi.jsx';
import JokeAPI from '../components/jokeApi.jsx';

---

<Layout
  title="Consultora AP Ltda"
  description="Soluciones integrales para potenciar tu negocio"
  heroImage=""
  pubDate={new Date('January 02 2025')}
>
  <section class="hero">
    <div class="hero-content">
      <img src="/src/utilitarios/logo_Cuadrado-min.jpg" alt="Logo de Consultora AP Ltda" class="hero-logo">
      <h1 class="hero-title">Bienvenido a Consultora AP Ltda</h1>
      <p class="hero-subtitle">
        Soluciones integrales para potenciar tu negocio.
      </p>
      <a href="#servicios" class="btn-primary">Conoce nuestros servicios</a>
    </div>
  </section>

  <section class="image-section">
    <img src="/src/utilitarios/1500x844_consultoria_ahorro.png" alt="Consultoría y ahorro" class="featured-image">
  </section>

  <section id="servicios" class="admin-container">
    <h2>Nuestros servicios</h2>
    <BotonesComplejos client:only="react" />
  </section>


  <section class="about">
    <h2 class="section-title">Quiénes Somos</h2>
    <p>
      En Consultora AP Ltda, contamos con un equipo de expertos dedicados a brindar soluciones personalizadas que se adapten a las necesidades de nuestros clientes.
    </p>
    <a href="/contact" class="btn-primary">Contáctanos</a>
  </section>
  <!-- Sección de indicadores económicos -->
  <section id="indicadores" class="indicadores-container">
    <IndicadoresEconomicos client:only="react" />
  </section>
    <DogAPI client:only="react" />
  </section>
    <!-- Sección de chistes -->
    <section id="chistes" class="chistes-container">
      <JokeAPI client:only="react" />
    </section>

  <style>
    .hero-logo {
      max-width: 100px;
      height: auto;
      display: block;
      margin: 0 auto 20px auto;
      border-radius: 10px;
    }

    .hero-content {
      text-align: center;
    }

    .btn-primary {
      padding: 10px 20px;
      background-color: #007BFF;
      color: white;
      text-decoration: none;
      border-radius: 5px;
      display: inline-block;
      margin-top: 40px;
      margin-bottom: 60px;
    }

    .btn-primary:hover {
      background-color: #0056b3;
    }

    .image-section {
      text-align: center;
      margin: 40px 0;
    }

    .featured-image {
      max-width: 100%;
      height: auto;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .services-grid {
      display: flex;
      flex-wrap: nowrap;
      justify-content: space-around;
      gap: 20px;
      margin-top: 40px;
    }

    .service-card {
      flex: 1 1 calc(33.333% - 20px);
      max-width: calc(33.333% - 20px);
      background: #f9f9f9;
      padding: 20px;
      border: 1px solid #ddd;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      text-align: center;
      transition: transform 0.3s ease;
    }

    .service-card:hover {
      transform: scale(1.05);
    }

    .service-card h3 {
      margin-bottom: 10px;
      font-size: 1.25rem;
      color: #007BFF;
    }

    .service-card p {
      font-size: 1rem;
      color: #555;
    }

    .material-icons {
      font-size: 48px;
      color: #007BFF;
      margin-bottom: 10px;
    }

    .section-title {
      text-align: center;
      font-size: 2rem;
      margin-bottom: 20px;
      color: #007BFF;
    }

    .about {
      text-align: center;
    }

    .indicadores-container {
      padding: 20px;
      background-color: #f9f9f9;
      border-radius: 8px;
      margin-top: 40px;
    }
  </style>
</Layout>
