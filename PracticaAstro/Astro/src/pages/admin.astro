---
import TablaMensajes from '../components/TablaMensajes.jsx';
import Layout from '../layouts/BlogPost.astro';
---

<Layout
  title="Admin - Consultora AP"
  description="Sistema CRM para Consultora AP"
  pubDate={new Date()}
>
  <section class="admin-container">
    <h2>Mensajes Recibidos</h2>
    <TablaMensajes client:load />
  </section>

  <style>
    .admin-container {
      max-width: 800px;
      margin: 50px auto;
      padding: 20px;
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    h2 {
      text-align: center;
      margin-bottom: 20px;
      color: #333;
    }
  </style>
</Layout>
