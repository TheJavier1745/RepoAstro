---
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminPanel from '../components/Admin.jsx';

const title = "Panel de Administración";
const description = "Administra usuarios y mensajes de contacto.";
---

<AdminLayout title={title} description={description}>
  <AdminPanel client:only="react"/>
</AdminLayout>

<style>
  .alert-error {
    color: red;
    font-weight: bold;
    padding: 10px;
    background-color: #ffe5e5;
    border: 1px solid red;
    margin-bottom: 15px;
    border-radius: 4px;
  }
</style>
