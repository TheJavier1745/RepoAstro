---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description, pubDate, heroImage } = Astro.props;
---

<html lang="es">
<head>
    <BaseHead title={title} description={description} />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <style>
        /* 🔹 Asegurar que el contenido ocupe toda la pantalla antes del footer */
        html, body {
            height: 100%;
            margin: 0;
            display: flex;
            flex-direction: column;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            color: #343a40;
        }

        /* 🔹 Hacer que el `main` empuje el footer hacia abajo */
        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            width: calc(100% - 4em);
            max-width: 1200px;
            margin: 6em auto 2em auto;
            padding: 2em;
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.1);
        }

        /* 🔹 Imagen de cabecera */
        .hero-image {
            width: 100%;
            max-height: 400px;
            object-fit: cover;
            border-radius: 10px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
            display: block;
            margin: 0 auto 20px auto;
        }

        .title {
            text-align: center;
            font-size: 2.5rem;
            font-weight: bold;
            color: #222;
            margin-bottom: 20px;
        }

        .date {
            text-align: center;
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 15px;
        }

        .prose {
            max-width: 800px;
            margin: auto;
            padding: 1.5em;
            color: #333;
            font-size: 1.125rem;
            line-height: 1.8;
        }

        /* RESPONSIVE */
        @media screen and (max-width: 768px) {
            main {
                padding: 1em;
            }

            .title {
                font-size: 2rem;
            }

            .prose {
                font-size: 1rem;
            }
        }
    </style>
</head>

<body>
    <Header />

    <main id="main-content">
        <div class="content">
            {heroImage && <img src={heroImage} alt={title} class="hero-image" />}

            <div class="title">{title}</div>
            <div class="date">
                 {pubDate.toLocaleDateString("es-ES")}
            </div>

            <div class="prose">
                <slot />  <!-- Contenido del blog aquí -->
            </div>
        </div>
    </main>

    <Footer />
</body>
</html>
