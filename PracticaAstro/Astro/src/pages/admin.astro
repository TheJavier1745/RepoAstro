---
import { prisma } from '../../prisma/prisma'; // Importa el cliente Prisma
import Layout from '../layouts/BlogPost.astro';
import DataGridComponent from '../components/TablaMensajes.jsx'; // Importa el componente React


// Consulta los datos desde la base de datos
const mensajes = await prisma.datos.findMany({
  orderBy: {
    fecha_hora: 'desc',
  },
});

// Configuración de columnas para DataGrid
const columns = [
  { field: 'id', headerName: 'ID', width: 80 },
  { field: 'nombres', headerName: 'Nombre', width: 150 },
  { field: 'correo', headerName: 'Correo', width: 250 },
  { field: 'mensaje', headerName: 'Mensaje', width: 300 },
  { field: 'fecha_hora', headerName: 'Fecha y Hora', width: 200 },
];

const rows = mensajes.map((mensaje) => ({
  id: mensaje.id,
  nombres: mensaje.nombres,
  correo: mensaje.correo,
  mensaje: mensaje.mensaje,
  fecha_hora: new Date(mensaje.fecha_hora).toLocaleString(),
}));
---

<Layout>
  <h1>Panel de Administración</h1>
  <DataGridComponent rows={rows} columns={columns} client:only="react" />
</Layout>